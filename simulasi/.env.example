# Simulasi GPS — env
SUPABASE_URL=your-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Simulasi
# Truk yang disimulasikan = semua truk status 'aktif' di tabel trucks
# (identitas dari scripts/fleet-data.js). Tidak ada lagi ANTAR_JUMLAH_TRUK.
# Benih variasi kecepatan (generator berbenih, bukan Math.random()).
ANTAR_BENIH=circle-t-simulasi
ANTAR_INTERVAL_DETIK=3
ANTAR_KECEPATAN_KMJ=45
# Hapus positions lebih tua dari ini (hari). Tanpa ini ±280 ribu baris/hari.
ANTAR_RETENSI_HARI=3
