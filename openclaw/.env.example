# OpenClaw skill + server Antar — env
SUPABASE_URL=your-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# HTTP tipis (server.py). Default 127.0.0.1:8765; di VPS: HOST=0.0.0.0
HOST=127.0.0.1
PORT=8765
# Auth: kalau di-set, semua request wajib bawa header X-API-KEY
OPENCLAW_API_KEY=
# LLM perangkai kalimat (opsional; kosong = mode template/luring permanen)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=25
# Cache TTL detik untuk posisi (default 8)
CACHE_TTL=8
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
