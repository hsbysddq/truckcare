# Telegram bot — env
SUPABASE_URL=your-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Chat ID owner bootstrap: selalu boleh akses walau tabel bot_akses belum
# dibuat (anti-lockout). Akses lain dikelola dari dashboard Pengaturan.
TELEGRAM_CHAT_ID=your-chat-id
# Rate limit: max request per menit per chat ID (default 30). Pemilik
# (TELEGRAM_CHAT_ID) selalu bebas dari batas ini.
TELEGRAM_RATE_LIMIT=30
