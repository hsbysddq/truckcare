# Supabase backend (sama dengan project multibackend)
NEXT_PUBLIC_SUPABASE_URL=https://dtwiihbfghukcknhofwo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dari-sini
# server-side only (jangan bocor ke browser)
SUPABASE_SERVICE_ROLE_KEY=isi-dari-dashboard
# OpenClaw AI di VPS lomba (batch 2, aktif 6-10 Sep)
OPENCLAW_ENDPOINT=http://103.30.146.216:8765
# Bot Telegram — server-side only (bukan NEXT_PUBLIC_), dipakai halaman
# Pengaturan untuk cek status (getMe) dan kirim pesan uji.
TELEGRAM_BOT_TOKEN=isi-dari-botfather
# Chat pemilik: tujuan default pesan uji bila chat_id tidak diisi.
TELEGRAM_CHAT_ID=123456789
# Cloudflare Turnstile untuk form pengaduan publik. Site key ke browser,
# secret + hostname ke server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEtxg5Html0HY9L4
TURNSTILE_SECRET=isi-dari-dashboard-cloudflare
# host frontend yang boleh submit (koma-terpisah). Di produksi JANGAN isi
# localhost. Contoh dev: "localhost", contoh prod: "circletindonesia.vercel.app".
TURNSTILE_HOSTNAMES=circletindonesia.vercel.app
